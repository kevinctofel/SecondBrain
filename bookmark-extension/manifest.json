{
  "manifest_version": 3,
  "name": "SecondBrain Bookmarks",
  "version": "1.0.0",
  "description": "Save web pages to your SecondBrain blog with AI-generated summaries.",
  "permissions": [
    "tabs",
    "storage",
    "contextMenus"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Save to Bookmarks"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
